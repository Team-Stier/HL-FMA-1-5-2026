<launch>
  <!-- Use existing live/replay localization and sensors. -->
  <arg name="start_mission" default="true"/>
  <arg name="start_detection" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="config_file" default="$(find state_manager)/config/missions.json"/>
  <arg name="calibration_file" default="$(env HOME)/.ros/stier/landmarks.json"/>
  <include if="$(arg start_mission)" file="$(find state_manager)/launch/mission.launch">
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="start_rviz" value="false"/>
    <arg name="start_object_detection" value="$(arg start_detection)"/>
  </include>
  <node pkg="state_manager" type="mission_inspection_node" name="mission_inspection" output="screen" required="true"/>
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="inspection_rviz"
        args="-d $(find state_manager)/rviz/state_manager.rviz"/>
</launch>
