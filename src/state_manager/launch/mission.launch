<launch>
  <arg name="rddf_directory" default="$(find mando_localization)/rddf"/>
  <!-- Sensor drivers and localization run separately. -->
  <arg name="config_file" default="$(find state_manager)/config/missions.json"/>
  <arg name="calibration_file" default="$(env HOME)/.ros/stier/landmarks.json"/>
  <arg name="calibration_mode" default="false"/>
  <arg name="start_object_detection" default="true"/>
  <arg name="start_local_planner" default="true"/>
  <arg name="start_traffic_light" default="true"/>
  <arg name="traffic_light_device" default="auto"/>
  <arg name="start_control" default="true"/>
  <arg name="lateral_controller" default="pure_pursuit"/>
  <arg name="control_calibration_required" default="false"/>
  <arg name="lookahead_m" default=""/>
  <arg name="target_speed_kph" default=""/>
  <arg name="adaptive_speed_enabled" default=""/>
  <arg name="normal_speed_kph" default=""/>
  <arg name="hill_speed_kph" default=""/>
  <arg name="static_speed_kph" default=""/>
  <arg name="intersection_speed_kph" default=""/>
  <arg name="parking_speed_kph" default=""/>
  <arg name="t_parking_side" default=""/>
  <arg name="parallel_parking_side" default=""/>
  <arg name="start_rviz" default="false"/>
  <node respawn="true" respawn_delay="3.0" pkg="mando_localization" type="rddf_route_provider.py" name="rddf_route_provider" output="screen">
    <param name="rddf_directory" value="$(arg rddf_directory)"/>
  </node>
  <node respawn="true" respawn_delay="3.0" pkg="state_manager" type="state_manager_node" name="state_manager" output="screen">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="calibration_file" value="$(arg calibration_file)"/>
    <param name="calibration_mode" value="$(arg calibration_mode)"/>
    <param name="t_parking_side" value="$(arg t_parking_side)" type="str"/>
    <param name="parallel_parking_side" value="$(arg parallel_parking_side)" type="str"/>
    <param name="normal_speed_kph" value="$(arg normal_speed_kph)" type="str"/>
    <param name="hill_speed_kph" value="$(arg hill_speed_kph)" type="str"/>
    <param name="static_speed_kph" value="$(arg static_speed_kph)" type="str"/>
    <param name="intersection_speed_kph" value="$(arg intersection_speed_kph)" type="str"/>
    <param name="parking_speed_kph" value="$(arg parking_speed_kph)" type="str"/>
  </node>
  <include if="$(arg start_object_detection)"
           file="$(find object_detection)/launch/rddf_roi_detection.launch">
    <arg name="rddf_directory" value="$(arg rddf_directory)"/>
    <arg name="start_viewer" value="false"/>
  </include>
  <include if="$(arg start_local_planner)"
           file="$(find path_planner)/launch/path_planner.launch"/>
  <include if="$(arg start_traffic_light)"
           file="$(find traffic_light)/launch/traffic_light.launch">
    <arg name="device" value="$(arg traffic_light_device)"/>
  </include>
  <include file="$(find selector)/launch/selector.launch"/>
  <include if="$(eval arg('start_control') and not arg('calibration_mode'))"
           file="$(find control)/launch/control.launch">
    <arg name="lateral_controller" value="$(arg lateral_controller)"/>
    <arg name="calibration_required" value="$(arg control_calibration_required)"/>
    <arg name="lookahead_m" value="$(arg lookahead_m)"/>
    <arg name="target_speed_kph" value="$(arg target_speed_kph)"/>
    <arg name="adaptive_speed_enabled" value="$(arg adaptive_speed_enabled)"/>
  </include>
  <node respawn="true" respawn_delay="3.0" if="$(arg calibration_mode)" pkg="state_manager" type="landmark_editor_node" name="landmark_editor" output="screen">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="calibration_mode" value="true"/>
    <param name="calibration_file" value="$(arg calibration_file)"/>
  </node>
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="mission_rviz" args="-d $(find state_manager)/rviz/state_manager.rviz"/>
</launch>
