#!/usr/bin/env python3
"""HL-FMA2026 GNSS/IMU Localization Node.

README의 공개 계약대로 NavSatFix, GpsStatus, Imu를 받아 map 좌표의
``/current_pos``를 발행한다. 위치 계산은 소규모 주행 영역용 WGS84 local
tangent projection이며, 첫 유효 fix 또는 측량 datum을 기준으로 사용한다.
"""

import copy
import math
import threading

import rospy
from geometry_msgs.msg import PoseStamped, Quaternion
from sensor_interfaces.msg import GpsStatus
from sensor_msgs.msg import Imu, NavSatFix, NavSatStatus


WGS84_SEMI_MAJOR_AXIS_M = 6378137.0
WGS84_ECCENTRICITY_SQUARED = 6.69437999014e-3


class Datum:
    """WGS84 기준점과 그 기준점이 대응하는 map 좌표를 보관한다."""

    def __init__(self, latitude_deg, longitude_deg, altitude_m, map_x, map_y, map_z):
        self.latitude_deg = latitude_deg
        self.longitude_deg = longitude_deg
        self.altitude_m = altitude_m
        self.map_x = map_x
        self.map_y = map_y
        self.map_z = map_z


def normalize_angle(angle):
    """각도를 [-pi, pi] 범위로 정규화한다."""
    return math.atan2(math.sin(angle), math.cos(angle))


def normalize_quaternion(quaternion, tolerance):
    """유한하고 단위 길이에 가까운 quaternion을 정규화한다."""
    values = (quaternion.x, quaternion.y, quaternion.z, quaternion.w)
    if not all(math.isfinite(value) for value in values):
        raise ValueError("non_finite_quaternion")
    norm = math.sqrt(sum(value * value for value in values))
    if norm < 1.0e-12 or abs(norm - 1.0) > tolerance:
        raise ValueError("invalid_quaternion_norm")
    result = Quaternion()
    result.x = quaternion.x / norm
    result.y = quaternion.y / norm
    result.z = quaternion.z / norm
    result.w = quaternion.w / norm
    return result


def quaternion_yaw(quaternion):
    """정규화된 quaternion의 yaw를 반환한다."""
    return math.atan2(
        2.0 * (quaternion.w * quaternion.z + quaternion.x * quaternion.y),
        1.0 - 2.0 * (quaternion.y * quaternion.y + quaternion.z * quaternion.z),
    )


def yaw_quaternion(yaw):
    """planar yaw를 quaternion으로 변환한다."""
    result = Quaternion()
    result.z = math.sin(0.5 * yaw)
    result.w = math.cos(0.5 * yaw)
    return result


def compose_output_yaw(imu_orientation, imu_yaw_offset, reference_yaw):
    """IMU yaw와 측정된 planar 보정을 map yaw로 합성한다."""
    return normalize_angle(
        quaternion_yaw(imu_orientation) + imu_yaw_offset + reference_yaw
    )


def rotate_planar_vector(x, y, yaw):
    """base frame의 planar vector를 주어진 map yaw로 회전한다."""
    cosine = math.cos(yaw)
    sine = math.sin(yaw)
    return cosine * x - sine * y, sine * x + cosine * y


def valid_latitude_longitude(latitude_deg, longitude_deg):
    """WGS84 위도/경도가 유한하고 정의역 안인지 확인한다."""
    return (
        math.isfinite(latitude_deg)
        and math.isfinite(longitude_deg)
        and -90.0 <= latitude_deg <= 90.0
        and -180.0 <= longitude_deg <= 180.0
    )


def project_to_map(latitude_deg, longitude_deg, altitude_m, datum, yaw_offset):
    """datum 주변 WGS84 차이를 ENU map 좌표로 투영한다."""
    latitude_rad = math.radians(datum.latitude_deg)
    sine_latitude = math.sin(latitude_rad)
    denominator = math.sqrt(
        1.0 - WGS84_ECCENTRICITY_SQUARED * sine_latitude * sine_latitude
    )
    prime_vertical_radius = WGS84_SEMI_MAJOR_AXIS_M / denominator
    meridian_radius = (
        WGS84_SEMI_MAJOR_AXIS_M
        * (1.0 - WGS84_ECCENTRICITY_SQUARED)
        / (denominator * denominator * denominator)
    )
    east = (
        prime_vertical_radius
        * math.cos(latitude_rad)
        * math.radians(longitude_deg - datum.longitude_deg)
    )
    north = meridian_radius * math.radians(latitude_deg - datum.latitude_deg)
    cosine = math.cos(yaw_offset)
    sine = math.sin(yaw_offset)
    return (
        datum.map_x + cosine * east - sine * north,
        datum.map_y + sine * east + cosine * north,
        datum.map_z + altitude_m - datum.altitude_m,
    )


def horizontal_distance_between_fixes(first, second):
    """서로 가까운 두 WGS84 fix 사이의 수평 거리를 계산한다."""
    temporary_datum = Datum(
        first.latitude, first.longitude, first.altitude, 0.0, 0.0, 0.0
    )
    x, y, _ = project_to_map(
        second.latitude, second.longitude, second.altitude, temporary_datum, 0.0
    )
    return math.hypot(x, y)


class LocalizationNode:
    """GPS 품질을 판정하고 IMU yaw를 결합해 차량 PoseStamped를 발행한다.

    Manager나 센서 드라이버의 역할을 가져오지 않는다. ``GpsStatus``와
    ``NavSatFix``가 모두 유효하고 IMU가 신선할 때만 새 pose를 발행하며,
    stale 데이터를 현재 시각으로 다시 찍어 내보내지 않는다.
    """

    def __init__(self):
        self._lock = threading.RLock()
        self._load_parameters()
        self._latest_status = None
        self._latest_status_receipt = rospy.Time()
        self._latest_imu = None
        self._latest_imu_receipt = rospy.Time()
        self._last_fix_stamp = rospy.Time()
        self._last_candidate_fix = None
        self._last_candidate_point = None
        self._last_published_point = None
        self._consecutive_fixes = 0

        self._datum = self._load_manual_datum_if_configured()
        self._publisher = rospy.Publisher(
            self._current_pose_topic, PoseStamped, queue_size=10
        )
        self._status_subscriber = rospy.Subscriber(
            self._gps_status_topic, GpsStatus, self._status_callback, queue_size=20
        )
        self._imu_subscriber = rospy.Subscriber(
            self._imu_topic, Imu, self._imu_callback, queue_size=100
        )
        self._fix_subscriber = rospy.Subscriber(
            self._gps_fix_topic, NavSatFix, self._fix_callback, queue_size=20
        )

        if self._calibration_state != "measured":
            rospy.logwarn(
                "Localization 외부 파라미터가 실측되지 않았습니다: calibration_state=%s",
                self._calibration_state,
            )
        rospy.loginfo(
            "Localization: %s + %s + %s -> %s, datum=%s",
            self._gps_fix_topic,
            self._gps_status_topic,
            self._imu_topic,
            self._current_pose_topic,
            self._reference_mode,
        )

    def _required(self, name):
        return rospy.get_param("~" + name)

    def _load_parameters(self):
        self._gps_fix_topic = self._required("topics/gps_fix")
        self._gps_status_topic = self._required("topics/gps_status")
        self._imu_topic = self._required("topics/imu")
        self._current_pose_topic = self._required("topics/current_pose")
        self._gps_frame = self._required("frames/gps")
        self._imu_frame = self._required("frames/imu")
        self._output_frame = self._required("frames/output")
        self._allow_unmeasured_test_mode = bool(
            self._required("operation/allow_unmeasured_test_mode")
        )

        self._reference_mode = self._required("reference/mode")
        self._reference_measured = bool(self._required("reference/measured"))
        self._reference_yaw = float(self._required("reference/yaw_offset_rad"))
        self._gps_translation = [
            float(value)
            for value in self._required("extrinsics/gps_translation_base_m")
        ]
        self._imu_yaw_offset = float(self._required("extrinsics/imu_yaw_offset_rad"))
        self._calibration_state = self._required("extrinsics/calibration_state")

        self._fix_max_age = float(self._required("quality/gps_fix_max_age_sec"))
        self._status_timeout = float(self._required("quality/gps_status_timeout_sec"))
        self._imu_timeout = float(self._required("quality/imu_timeout_sec"))
        self._max_future_stamp = float(self._required("quality/max_future_stamp_sec"))
        self._max_status_fix_skew = float(
            self._required("quality/max_status_fix_skew_sec")
        )
        self._max_imu_fix_skew = float(self._required("quality/max_imu_fix_skew_sec"))
        self._quaternion_tolerance = float(
            self._required("quality/quaternion_norm_tolerance")
        )
        self._max_imu_orientation_variance = float(
            self._required("quality/max_imu_orientation_variance_rad2")
        )
        self._allow_unknown_imu_covariance = bool(
            self._required("quality/allow_unknown_imu_orientation_covariance")
        )
        self._allowed_solutions = set(
            int(value) for value in self._required("quality/allowed_solutions")
        )
        self._allowed_fix_types = set(
            int(value) for value in self._required("quality/allowed_fix_types")
        )
        self._require_nav_status = bool(self._required("quality/require_nav_status"))
        self._allowed_spoofing = set(
            int(value) for value in self._required("quality/allowed_spoofing_states")
        )
        self._min_satellites = int(self._required("quality/min_satellites_used"))
        self._max_horizontal_accuracy = float(
            self._required("quality/max_horizontal_accuracy_m")
        )
        self._max_vertical_accuracy = float(
            self._required("quality/max_vertical_accuracy_m")
        )
        self._max_navsat_horizontal_variance = float(
            self._required("quality/max_navsat_horizontal_variance_m2")
        )
        self._required_consecutive = int(
            self._required("quality/required_consecutive_fixes")
        )
        self._max_step_distance = float(self._required("quality/max_step_distance_m"))
        self._reset_gap = float(self._required("quality/reset_gap_sec"))
        self._planar_mode = bool(self._required("output/planar_mode"))

        topics = (
            self._gps_fix_topic,
            self._gps_status_topic,
            self._imu_topic,
            self._current_pose_topic,
        )
        if not all(rospy.names.is_global(topic) for topic in topics):
            raise ValueError("all localization topics must be absolute ROS names")
        if len(self._gps_translation) != 3 or not all(
            math.isfinite(value) for value in self._gps_translation
        ):
            raise ValueError("gps_translation_base_m must contain three finite values")
        if not math.isfinite(self._reference_yaw) or not math.isfinite(
            self._imu_yaw_offset
        ):
            raise ValueError("yaw offsets must be finite")
        frames = (self._gps_frame, self._imu_frame, self._output_frame)
        if not all(frame and not frame.startswith("/") for frame in frames):
            raise ValueError("localization frame IDs must be nonempty and relative")
        positive_values = (
            self._fix_max_age,
            self._status_timeout,
            self._imu_timeout,
            self._max_status_fix_skew,
            self._max_imu_fix_skew,
            self._quaternion_tolerance,
            self._max_imu_orientation_variance,
            self._max_horizontal_accuracy,
            self._max_vertical_accuracy,
            self._max_navsat_horizontal_variance,
            self._max_step_distance,
            self._reset_gap,
        )
        if not all(math.isfinite(value) and value > 0.0 for value in positive_values):
            raise ValueError("localization quality limits must be finite and positive")
        if self._max_future_stamp < 0.0 or not math.isfinite(self._max_future_stamp):
            raise ValueError("max_future_stamp_sec must be finite and nonnegative")
        if self._required_consecutive <= 0 or self._min_satellites < 0:
            raise ValueError("fix and satellite counts must be valid")
        if (
            not self._allowed_solutions
            or not self._allowed_fix_types
            or not self._allowed_spoofing
        ):
            raise ValueError("allowed GNSS status sets must not be empty")
        if self._reference_mode not in ("first_fix", "manual_datum"):
            raise ValueError("reference/mode must be first_fix or manual_datum")
        if self._calibration_state not in ("unmeasured", "measured"):
            raise ValueError("calibration_state must be unmeasured or measured")
        if self._reference_mode == "first_fix" and not self._allow_unmeasured_test_mode:
            raise ValueError("first_fix is allowed only by the explicit test configuration")
        if (
            self._reference_mode == "manual_datum"
            and self._calibration_state != "measured"
        ):
            raise ValueError("manual_datum requires measured sensor extrinsics")
        if not self._planar_mode:
            raise ValueError("only planar_mode=true is currently supported")

    def _load_manual_datum_if_configured(self):
        if self._reference_mode == "first_fix":
            return None
        measured_at = self._required("reference/measured_at")
        source = self._required("reference/source")
        values = [
            float(self._required("reference/latitude_deg")),
            float(self._required("reference/longitude_deg")),
            float(self._required("reference/altitude_m")),
            float(self._required("reference/map_x_m")),
            float(self._required("reference/map_y_m")),
            float(self._required("reference/map_z_m")),
        ]
        if (
            not self._reference_measured
            or not measured_at
            or not source
            or not valid_latitude_longitude(values[0], values[1])
            or not all(math.isfinite(value) for value in values)
        ):
            raise ValueError("manual_datum requires measured WGS84/map metadata")
        return Datum(*values)

    def _status_callback(self, message):
        with self._lock:
            self._latest_status = copy.deepcopy(message)
            self._latest_status_receipt = rospy.Time.now()

    def _imu_callback(self, message):
        with self._lock:
            self._latest_imu = copy.deepcopy(message)
            self._latest_imu_receipt = rospy.Time.now()

    def _reject(self, reason):
        self._consecutive_fixes = 0
        self._last_candidate_fix = None
        self._last_candidate_point = None
        rospy.logwarn_throttle(1.0, "Localization 입력 거부: %s", reason)

    def _validate_fix(self, message, now):
        if message.header.stamp.is_zero():
            return "gps_zero_stamp"
        if message.header.frame_id != self._gps_frame:
            return "gps_frame_mismatch"
        age = (now - message.header.stamp).to_sec()
        if age > self._fix_max_age or age < -self._max_future_stamp:
            return "gps_stale_or_future"
        if message.status.status < NavSatStatus.STATUS_FIX:
            return "navsat_no_fix"
        if not valid_latitude_longitude(message.latitude, message.longitude):
            return "invalid_latitude_longitude"
        if not math.isfinite(message.altitude):
            return "invalid_altitude"
        if message.position_covariance_type != NavSatFix.COVARIANCE_TYPE_UNKNOWN:
            variance_east = message.position_covariance[0]
            variance_north = message.position_covariance[4]
            if (
                not math.isfinite(variance_east)
                or not math.isfinite(variance_north)
                or variance_east < 0.0
                or variance_north < 0.0
                or variance_east > self._max_navsat_horizontal_variance
                or variance_north > self._max_navsat_horizontal_variance
            ):
                return "navsat_horizontal_variance"
        return ""

    def _validate_status(self, fix, now):
        status = self._latest_status
        if status is None or self._latest_status_receipt.is_zero():
            return "gps_status_missing"
        receipt_age = (now - self._latest_status_receipt).to_sec()
        if receipt_age < 0.0 or receipt_age > self._status_timeout:
            return "gps_status_stale"
        if status.header.stamp.is_zero() or status.header.frame_id != self._gps_frame:
            return "gps_status_header"
        if abs((status.header.stamp - fix.header.stamp).to_sec()) > self._max_status_fix_skew:
            return "gps_status_fix_skew"
        if not status.fix_ok or status.solution not in self._allowed_solutions:
            return "gps_solution_rejected"
        if status.fix_type not in self._allowed_fix_types:
            return "gps_fix_type_rejected"
        if self._require_nav_status and not status.nav_status_available:
            return "gps_nav_status_unavailable"
        if status.spoofing_state not in self._allowed_spoofing:
            return "gps_spoofing_rejected"
        if status.satellites_used < self._min_satellites:
            return "gps_satellites_insufficient"
        accuracy = (status.horizontal_accuracy_m, status.vertical_accuracy_m)
        if not all(math.isfinite(value) and value >= 0.0 for value in accuracy):
            return "gps_accuracy_invalid"
        if (
            status.horizontal_accuracy_m > self._max_horizontal_accuracy
            or status.vertical_accuracy_m > self._max_vertical_accuracy
        ):
            return "gps_accuracy_too_large"
        return ""

    def _validated_imu_orientation(self, fix, now):
        imu = self._latest_imu
        if imu is None or self._latest_imu_receipt.is_zero():
            return None, "imu_missing"
        receipt_age = (now - self._latest_imu_receipt).to_sec()
        if receipt_age < 0.0 or receipt_age > self._imu_timeout:
            return None, "imu_stale"
        if imu.header.stamp.is_zero() or imu.header.frame_id != self._imu_frame:
            return None, "imu_header"
        if abs((imu.header.stamp - fix.header.stamp).to_sec()) > self._max_imu_fix_skew:
            return None, "imu_fix_skew"
        orientation_variances = (
            imu.orientation_covariance[0],
            imu.orientation_covariance[4],
            imu.orientation_covariance[8],
        )
        covariance_is_unknown = all(variance == 0.0 for variance in orientation_variances)
        covariance_is_valid = all(
            math.isfinite(variance)
            and 0.0 < variance <= self._max_imu_orientation_variance
            for variance in orientation_variances
        )
        if not covariance_is_valid:
            if not (self._allow_unknown_imu_covariance and covariance_is_unknown):
                return None, "imu_orientation_unavailable"
            rospy.logwarn_throttle(
                5.0,
                "TEST ONLY: IMU orientation covariance가 0이라 정확도를 알 수 없는 "
                "자세를 사용합니다",
            )
        try:
            orientation = normalize_quaternion(imu.orientation, self._quaternion_tolerance)
        except ValueError as error:
            return None, str(error)
        return orientation, ""

    def _fix_callback(self, message):
        with self._lock:
            now = rospy.Time.now()
            reason = self._validate_fix(message, now)
            if not reason:
                reason = self._validate_status(message, now)
            orientation = None
            if not reason:
                orientation, reason = self._validated_imu_orientation(message, now)
            if reason:
                self._reject(reason)
                return

            if not self._last_fix_stamp.is_zero():
                gap = (message.header.stamp - self._last_fix_stamp).to_sec()
                if gap <= 0.0:
                    self._reject("gps_time_epoch_or_gap")
                    return
                if gap > self._reset_gap:
                    self._reject("gps_time_gap")
            self._last_fix_stamp = message.header.stamp

            if self._datum is None:
                if self._last_candidate_fix is not None:
                    distance = horizontal_distance_between_fixes(
                        self._last_candidate_fix, message
                    )
                    if distance > self._max_step_distance:
                        self._reject("gps_candidate_step")
                self._last_candidate_fix = copy.deepcopy(message)
                self._consecutive_fixes += 1
                if self._consecutive_fixes < self._required_consecutive:
                    return
                first_yaw = compose_output_yaw(
                    orientation,
                    self._imu_yaw_offset,
                    self._reference_yaw,
                )
                lever_x, lever_y, _ = self._gps_translation
                datum_map_x, datum_map_y = rotate_planar_vector(
                    lever_x, lever_y, first_yaw
                )
                self._datum = Datum(
                    message.latitude,
                    message.longitude,
                    message.altitude,
                    datum_map_x,
                    datum_map_y,
                    0.0,
                )
                point = (datum_map_x, datum_map_y, 0.0)
                rospy.loginfo(
                    "첫 승인 GPS를 map 원점으로 설정했습니다: lat=%.9f lon=%.9f",
                    message.latitude,
                    message.longitude,
                )
            else:
                point = project_to_map(
                    message.latitude,
                    message.longitude,
                    message.altitude,
                    self._datum,
                    self._reference_yaw,
                )
                if self._last_published_point is not None:
                    trusted_step = math.hypot(
                        point[0] - self._last_published_point[0],
                        point[1] - self._last_published_point[1],
                    )
                    if trusted_step > self._max_step_distance:
                        self._reject("gps_step_from_last_published")
                        return
                if self._last_candidate_point is not None:
                    step = math.hypot(
                        point[0] - self._last_candidate_point[0],
                        point[1] - self._last_candidate_point[1],
                    )
                    if step > self._max_step_distance:
                        self._reject("gps_projected_step")
                        return
                self._consecutive_fixes = min(
                    self._required_consecutive, self._consecutive_fixes + 1
                )
                if self._consecutive_fixes < self._required_consecutive:
                    self._last_candidate_point = point
                    return

            self._last_candidate_point = point
            self._publish_pose(message, orientation, point)
            self._last_published_point = point

    def _publish_pose(self, fix, imu_orientation, gps_point):
        output_yaw = compose_output_yaw(
            imu_orientation,
            self._imu_yaw_offset,
            self._reference_yaw,
        )
        lever_x, lever_y, lever_z = self._gps_translation
        rotated_lever_x, rotated_lever_y = rotate_planar_vector(
            lever_x, lever_y, output_yaw
        )

        output = PoseStamped()
        output.header.stamp = fix.header.stamp
        output.header.frame_id = self._output_frame
        output.pose.position.x = gps_point[0] - rotated_lever_x
        output.pose.position.y = gps_point[1] - rotated_lever_y
        output.pose.position.z = 0.0 if self._planar_mode else gps_point[2] - lever_z
        output.pose.orientation = yaw_quaternion(output_yaw)
        self._publisher.publish(output)


if __name__ == "__main__":
    rospy.init_node("localization")
    try:
        LocalizationNode()
        rospy.spin()
    except (KeyError, TypeError, ValueError, rospy.ROSException) as error:
        rospy.logfatal("Localization 설정 실패: %s", error)
        raise
