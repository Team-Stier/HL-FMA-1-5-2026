#!/usr/bin/env python3
"""Build local wheel/IMU odometry and a GPS-corrected global odometry.

``SerialFeedBack`` has no Header, so encoder samples are stamped at ROS receipt
time.  Encoder ticks are never treated as metres until an explicit
``encoder_meters_per_tick`` calibration is enabled.
"""

import copy
from collections import deque, namedtuple
import math
import threading

import rospy
from erp42_msgs.msg import SerialFeedBack
from geometry_msgs.msg import Point, PoseStamped, Quaternion, TransformStamped
from nav_msgs.msg import Odometry, Path
from sensor_msgs.msg import Imu
import tf2_ros
from visualization_msgs.msg import Marker


MotionSample = namedtuple("MotionSample", "stamp x y yaw speed yaw_rate distance")


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def quaternion_yaw(quaternion):
    return math.atan2(
        2.0 * (quaternion.w * quaternion.z + quaternion.x * quaternion.y),
        1.0 - 2.0 * (quaternion.y * quaternion.y + quaternion.z * quaternion.z),
    )


def yaw_quaternion(yaw):
    result = Quaternion()
    result.z = math.sin(0.5 * yaw)
    result.w = math.cos(0.5 * yaw)
    return result


def normalize_quaternion(quaternion, tolerance):
    values = (quaternion.x, quaternion.y, quaternion.z, quaternion.w)
    if not all(math.isfinite(value) for value in values):
        raise ValueError("non_finite_quaternion")
    norm = math.sqrt(sum(value * value for value in values))
    if norm < 1.0e-12 or abs(norm - 1.0) > tolerance:
        raise ValueError("invalid_quaternion_norm")
    result = Quaternion()
    result.x = quaternion.x / norm
    result.y = quaternion.y / norm
    result.z = quaternion.z / norm
    result.w = quaternion.w / norm
    return result


def shortest_encoder_delta(current, previous, modulus):
    """Return a signed counter delta, optionally correcting one rollover."""
    delta = int(current) - int(previous)
    if modulus > 1:
        half = modulus // 2
        delta = (delta + half) % modulus - half
    return delta


def encoder_sample_delta(current, previous, value_mode, modulus):
    """Decode SerialFeedBack.encoder according to the producer contract."""
    if value_mode == "window_delta":
        return int(current)
    if value_mode == "cumulative_count":
        if previous is None:
            return None
        return shortest_encoder_delta(current, previous, modulus)
    raise ValueError("unsupported encoder_value_mode")


def compose_planar_pose(transform, sample):
    """Compose map->odom with odom->base and return map pose."""
    tx, ty, transform_yaw = transform
    cosine = math.cos(transform_yaw)
    sine = math.sin(transform_yaw)
    return (
        tx + cosine * sample.x - sine * sample.y,
        ty + sine * sample.x + cosine * sample.y,
        normalize_angle(transform_yaw + sample.yaw),
    )


def vehicle_outline_points(length_m, width_m):
    """Return a closed, base-centered rectangle with +x as vehicle forward."""
    half_length = 0.5 * length_m
    half_width = 0.5 * width_m
    return (
        (half_length, half_width),
        (half_length, -half_width),
        (-half_length, -half_width),
        (-half_length, half_width),
        (half_length, half_width),
    )


class WheelImuGpsOdometryNode:
    """Integrate calibrated encoder ticks with IMU yaw and anchor them to GPS."""

    def __init__(self):
        self._lock = threading.RLock()
        self._load_parameters()

        self._latest_imu = None
        self._latest_imu_receipt = rospy.Time()
        self._latest_encoder = None
        self._latest_encoder_receipt = rospy.Time()
        self._previous_encoder = None
        self._previous_encoder_stamp = rospy.Time()
        self._local_initialized = False
        self._local_yaw_origin = 0.0
        self._local_x = 0.0
        self._local_y = 0.0
        self._local_yaw = 0.0
        self._local_distance = 0.0
        self._local_samples = deque()
        self._map_to_odom = None
        self._last_anchor_receipt = rospy.Time()
        self._last_anchor_stamp = rospy.Time()
        self._last_motion_reason = "waiting_for_encoder"
        self._last_anchor_reason = "waiting_for_gps_pose"

        self._local_path = Path()
        self._local_path.header.frame_id = self._odom_frame
        self._global_path = Path()
        self._global_path.header.frame_id = self._map_frame

        self._local_publisher = rospy.Publisher(
            self._local_odometry_topic, Odometry, queue_size=30
        )
        self._global_publisher = rospy.Publisher(
            self._global_odometry_topic, Odometry, queue_size=30
        )
        self._local_path_publisher = rospy.Publisher(
            self._local_path_topic, Path, queue_size=1, latch=True
        )
        self._global_path_publisher = rospy.Publisher(
            self._global_path_topic, Path, queue_size=1, latch=True
        )
        self._vehicle_marker_publisher = rospy.Publisher(
            self._vehicle_marker_topic, Marker, queue_size=1, latch=True
        )
        self._tf_broadcaster = tf2_ros.TransformBroadcaster()

        self._imu_subscriber = rospy.Subscriber(
            self._imu_topic, Imu, self._imu_callback, queue_size=100
        )
        self._encoder_subscriber = rospy.Subscriber(
            self._encoder_topic,
            SerialFeedBack,
            self._encoder_callback,
            queue_size=100,
        )
        self._pose_subscriber = rospy.Subscriber(
            self._current_pose_topic,
            PoseStamped,
            self._current_pose_callback,
            queue_size=30,
        )

        if not self._encoder_calibrated:
            rospy.logwarn(
                "Encoder 원시값은 수신하지만 encoder_meters_per_tick 실측 전에는 "
                "Local Odometry를 발행하지 않습니다"
            )
        rospy.loginfo(
            "Wheel/IMU/GPS odometry: %s + %s + %s -> %s, %s",
            self._encoder_topic,
            self._imu_topic,
            self._current_pose_topic,
            self._local_odometry_topic,
            self._global_odometry_topic,
        )

    @staticmethod
    def _required(name):
        return rospy.get_param("~" + name)

    def _load_parameters(self):
        self._encoder_topic = self._required("topics/encoder")
        self._imu_topic = self._required("topics/imu")
        self._current_pose_topic = self._required("topics/current_pose")
        self._local_odometry_topic = self._required("topics/local_odometry")
        self._global_odometry_topic = self._required("topics/global_odometry")
        self._local_path_topic = self._required("topics/local_path")
        self._global_path_topic = self._required("topics/global_path")
        self._vehicle_marker_topic = self._required("topics/vehicle_marker")

        self._imu_frame = self._required("frames/imu")
        self._map_frame = self._required("frames/output")
        self._odom_frame = self._required("frames/odom")
        self._base_frame = self._required("frames/base")

        self._encoder_calibrated = bool(
            self._required("motion/encoder_calibrated")
        )
        self._meters_per_tick = float(
            self._required("motion/encoder_meters_per_tick")
        )
        self._encoder_sign = float(self._required("motion/encoder_sign"))
        self._encoder_value_mode = self._required("motion/encoder_value_mode")
        self._encoder_modulus = int(self._required("motion/encoder_modulus"))
        self._direction_mode = self._required("motion/encoder_direction_mode")
        self._forward_gears = set(
            int(value) for value in self._required("motion/forward_gear_values")
        )
        self._reverse_gears = set(
            int(value) for value in self._required("motion/reverse_gear_values")
        )
        self._neutral_gears = set(
            int(value) for value in self._required("motion/neutral_gear_values")
        )
        self._max_encoder_delta = int(
            self._required("motion/max_encoder_delta_ticks")
        )
        self._min_feedback_dt = float(
            self._required("motion/min_feedback_dt_sec")
        )
        self._max_feedback_dt = float(
            self._required("motion/max_feedback_dt_sec")
        )
        self._max_speed = float(self._required("motion/max_encoder_speed_mps"))
        self._max_pose_sync = float(
            self._required("motion/max_gps_local_sync_sec")
        )
        self._history_duration = float(
            self._required("motion/local_history_duration_sec")
        )
        self._max_global_dr_age = float(
            self._required("motion/max_global_dead_reckoning_sec")
        )
        self._publish_tf = bool(self._required("motion/publish_tf"))
        self._local_position_variance = float(
            self._required("motion/local_position_variance_m2")
        )
        self._global_position_variance = float(
            self._required("motion/global_position_variance_m2")
        )

        self._imu_timeout = float(self._required("quality/imu_timeout_sec"))
        self._max_future_stamp = float(
            self._required("quality/max_future_stamp_sec")
        )
        self._quaternion_tolerance = float(
            self._required("quality/quaternion_norm_tolerance")
        )
        self._max_imu_orientation_variance = float(
            self._required("quality/max_imu_orientation_variance_rad2")
        )
        self._allow_unknown_imu_covariance = bool(
            self._required("quality/allow_unknown_imu_orientation_covariance")
        )
        self._imu_yaw_offset = float(
            self._required("extrinsics/imu_yaw_offset_rad")
        )
        self._path_max_poses = int(self._required("output/path_max_poses"))
        self._vehicle_length = float(
            self._required("visualization/vehicle_length_m")
        )
        self._vehicle_width = float(
            self._required("visualization/vehicle_width_m")
        )
        self._vehicle_outline_width = float(
            self._required("visualization/vehicle_outline_width_m")
        )

        topics = (
            self._encoder_topic,
            self._imu_topic,
            self._current_pose_topic,
            self._local_odometry_topic,
            self._global_odometry_topic,
            self._local_path_topic,
            self._global_path_topic,
            self._vehicle_marker_topic,
        )
        if not all(rospy.names.is_global(topic) for topic in topics):
            raise ValueError("all odometry topics must be absolute ROS names")
        frames = (
            self._imu_frame,
            self._map_frame,
            self._odom_frame,
            self._base_frame,
        )
        if not all(frame and not frame.startswith("/") for frame in frames):
            raise ValueError("odometry frame IDs must be nonempty and relative")
        if self._direction_mode not in ("signed_ticks", "gear"):
            raise ValueError("encoder_direction_mode must be signed_ticks or gear")
        if self._encoder_value_mode not in ("window_delta", "cumulative_count"):
            raise ValueError(
                "encoder_value_mode must be window_delta or cumulative_count"
            )
        if self._encoder_modulus < 0 or self._encoder_modulus == 1:
            raise ValueError("encoder_modulus must be 0 or greater than 1")
        if self._encoder_value_mode == "window_delta" and self._encoder_modulus != 0:
            raise ValueError("window_delta encoder must use encoder_modulus=0")
        if self._max_encoder_delta <= 0 or self._path_max_poses <= 0:
            raise ValueError("encoder delta and path limits must be positive")
        positive_values = (
            abs(self._encoder_sign),
            self._min_feedback_dt,
            self._max_feedback_dt,
            self._max_speed,
            self._max_pose_sync,
            self._history_duration,
            self._max_global_dr_age,
            self._local_position_variance,
            self._global_position_variance,
            self._imu_timeout,
            self._quaternion_tolerance,
            self._max_imu_orientation_variance,
            self._vehicle_length,
            self._vehicle_width,
            self._vehicle_outline_width,
        )
        if not all(math.isfinite(value) and value > 0.0 for value in positive_values):
            raise ValueError("motion and covariance limits must be finite and positive")
        if self._max_feedback_dt <= self._min_feedback_dt:
            raise ValueError("max_feedback_dt_sec must exceed min_feedback_dt_sec")
        if not math.isfinite(self._meters_per_tick) or self._meters_per_tick < 0.0:
            raise ValueError("encoder_meters_per_tick must be finite and nonnegative")
        if self._encoder_calibrated and self._meters_per_tick <= 0.0:
            raise ValueError("calibrated encoder requires positive meters_per_tick")
        if not math.isfinite(self._imu_yaw_offset):
            raise ValueError("imu_yaw_offset_rad must be finite")

    def _imu_callback(self, message):
        with self._lock:
            self._latest_imu = copy.deepcopy(message)
            self._latest_imu_receipt = rospy.Time.now()

    def _validated_imu_yaw(self, stamp):
        if self._latest_imu is None or self._latest_imu_receipt.is_zero():
            return None, None, "imu_missing"
        receipt_age = (stamp - self._latest_imu_receipt).to_sec()
        if receipt_age < 0.0 or receipt_age > self._imu_timeout:
            return None, None, "imu_stale"
        imu = self._latest_imu
        if imu.header.stamp.is_zero() or imu.header.frame_id != self._imu_frame:
            return None, None, "imu_header"
        stamp_age = (stamp - imu.header.stamp).to_sec()
        if stamp_age > self._imu_timeout or stamp_age < -self._max_future_stamp:
            return None, None, "imu_stamp_skew"
        variances = (
            imu.orientation_covariance[0],
            imu.orientation_covariance[4],
            imu.orientation_covariance[8],
        )
        covariance_unknown = all(value == 0.0 for value in variances)
        covariance_valid = all(
            math.isfinite(value)
            and 0.0 < value <= self._max_imu_orientation_variance
            for value in variances
        )
        if not covariance_valid and not (
            self._allow_unknown_imu_covariance and covariance_unknown
        ):
            return None, None, "imu_orientation_unavailable"
        try:
            orientation = normalize_quaternion(
                imu.orientation, self._quaternion_tolerance
            )
        except ValueError as error:
            return None, None, str(error)
        yaw = normalize_angle(quaternion_yaw(orientation) + self._imu_yaw_offset)
        yaw_rate = imu.angular_velocity.z
        if not math.isfinite(yaw_rate):
            yaw_rate = 0.0
        return yaw, yaw_rate, ""

    def _direction_multiplier(self, message, raw_delta):
        if self._direction_mode == "signed_ticks":
            return raw_delta
        magnitude = abs(raw_delta)
        if int(message.Gear) in self._forward_gears:
            return magnitude
        if int(message.Gear) in self._reverse_gears:
            return -magnitude
        if int(message.Gear) in self._neutral_gears:
            return 0
        raise ValueError("unknown_gear_value")

    def _encoder_callback(self, message):
        with self._lock:
            stamp = rospy.Time.now()
            self._latest_encoder = copy.deepcopy(message)
            self._latest_encoder_receipt = stamp
            if not self._encoder_calibrated:
                self._last_motion_reason = "encoder_calibration_required"
                return

            imu_yaw, yaw_rate, reason = self._validated_imu_yaw(stamp)
            if reason:
                self._last_motion_reason = reason
                rospy.logwarn_throttle(1.0, "Local Odometry 대기: %s", reason)
                return

            if self._previous_encoder is None:
                self._previous_encoder = int(message.encoder)
                self._previous_encoder_stamp = stamp
                self._local_yaw_origin = imu_yaw
                self._local_yaw = 0.0
                self._local_initialized = True
                sample = MotionSample(stamp, 0.0, 0.0, 0.0, 0.0, yaw_rate, 0.0)
                self._store_sample(sample)
                self._last_motion_reason = "ok"
                self._publish_local(sample)
                return

            dt = (stamp - self._previous_encoder_stamp).to_sec()
            if dt <= self._min_feedback_dt:
                self._last_motion_reason = "encoder_dt_too_small"
                return
            if dt > self._max_feedback_dt:
                self._previous_encoder = int(message.encoder)
                self._previous_encoder_stamp = stamp
                self._last_motion_reason = "encoder_time_gap"
                rospy.logwarn_throttle(1.0, "Encoder 시간 간격이 커서 적분을 건너뜁니다")
                return

            raw_delta = encoder_sample_delta(
                message.encoder,
                self._previous_encoder,
                self._encoder_value_mode,
                self._encoder_modulus,
            )
            self._previous_encoder = int(message.encoder)
            self._previous_encoder_stamp = stamp
            if abs(raw_delta) > self._max_encoder_delta:
                self._last_motion_reason = "encoder_delta_jump"
                rospy.logwarn_throttle(1.0, "Encoder count jump를 거부했습니다")
                return
            try:
                directed_delta = self._direction_multiplier(message, raw_delta)
            except ValueError as error:
                self._last_motion_reason = str(error)
                return
            distance = directed_delta * self._meters_per_tick * self._encoder_sign
            speed = distance / dt
            if not math.isfinite(speed) or abs(speed) > self._max_speed:
                self._last_motion_reason = "encoder_speed_out_of_range"
                rospy.logwarn_throttle(1.0, "Encoder 환산 속도를 거부했습니다: %.3f m/s", speed)
                return

            new_yaw = normalize_angle(imu_yaw - self._local_yaw_origin)
            yaw_step = normalize_angle(new_yaw - self._local_yaw)
            midpoint_yaw = normalize_angle(self._local_yaw + 0.5 * yaw_step)
            self._local_x += distance * math.cos(midpoint_yaw)
            self._local_y += distance * math.sin(midpoint_yaw)
            self._local_yaw = new_yaw
            self._local_distance += abs(distance)
            sample = MotionSample(
                stamp,
                self._local_x,
                self._local_y,
                self._local_yaw,
                speed,
                yaw_rate,
                self._local_distance,
            )
            self._store_sample(sample)
            self._last_motion_reason = "ok"
            self._publish_local(sample)

            if self._map_to_odom is not None and not self._last_anchor_receipt.is_zero():
                anchor_age = (stamp - self._last_anchor_receipt).to_sec()
                if 0.0 <= anchor_age <= self._max_global_dr_age:
                    self._publish_global_from_local(sample)
                else:
                    self._last_anchor_reason = "gps_anchor_stale"

    def _store_sample(self, sample):
        self._local_samples.append(sample)
        oldest_allowed = sample.stamp - rospy.Duration(self._history_duration)
        while self._local_samples and self._local_samples[0].stamp < oldest_allowed:
            self._local_samples.popleft()

    def _nearest_local_sample(self, stamp):
        if not self._local_samples:
            return None, math.inf
        sample = min(
            self._local_samples,
            key=lambda candidate: abs((candidate.stamp - stamp).to_sec()),
        )
        return sample, abs((sample.stamp - stamp).to_sec())

    def _current_pose_callback(self, message):
        with self._lock:
            now = rospy.Time.now()
            if message.header.stamp.is_zero() or message.header.frame_id != self._map_frame:
                self._last_anchor_reason = "current_pose_header"
                return
            values = (
                message.pose.position.x,
                message.pose.position.y,
                message.pose.position.z,
                message.pose.orientation.x,
                message.pose.orientation.y,
                message.pose.orientation.z,
                message.pose.orientation.w,
            )
            if not all(math.isfinite(value) for value in values):
                self._last_anchor_reason = "current_pose_non_finite"
                return
            try:
                orientation = normalize_quaternion(
                    message.pose.orientation, self._quaternion_tolerance
                )
            except ValueError as error:
                self._last_anchor_reason = str(error)
                return

            self._publish_global_pose(
                message.header.stamp,
                message.pose.position.x,
                message.pose.position.y,
                quaternion_yaw(orientation),
                0.0,
                0.0,
            )
            if not self._local_initialized:
                self._last_anchor_reason = "local_odometry_unavailable"
                return
            sample, skew = self._nearest_local_sample(message.header.stamp)
            if sample is None or skew > self._max_pose_sync:
                self._last_anchor_reason = "gps_local_time_skew"
                rospy.logwarn_throttle(
                    1.0,
                    "GPS correction과 Local Odometry 시각 차이가 큽니다: %.3f s",
                    skew,
                )
                return

            global_yaw = quaternion_yaw(orientation)
            transform_yaw = normalize_angle(global_yaw - sample.yaw)
            cosine = math.cos(transform_yaw)
            sine = math.sin(transform_yaw)
            rotated_x = cosine * sample.x - sine * sample.y
            rotated_y = sine * sample.x + cosine * sample.y
            self._map_to_odom = (
                message.pose.position.x - rotated_x,
                message.pose.position.y - rotated_y,
                transform_yaw,
            )
            self._last_anchor_receipt = now
            self._last_anchor_stamp = message.header.stamp
            self._last_anchor_reason = "ok"
            if self._publish_tf:
                self._broadcast_map_to_odom(now)

    def _make_odometry(self, stamp, frame, x, y, yaw, speed, yaw_rate, variance):
        output = Odometry()
        output.header.stamp = stamp
        output.header.frame_id = frame
        output.child_frame_id = self._base_frame
        output.pose.pose.position.x = x
        output.pose.pose.position.y = y
        output.pose.pose.orientation = yaw_quaternion(yaw)
        output.pose.covariance[0] = variance
        output.pose.covariance[7] = variance
        output.pose.covariance[14] = 1.0e6
        output.pose.covariance[21] = 1.0e6
        output.pose.covariance[28] = 1.0e6
        output.pose.covariance[35] = self._max_imu_orientation_variance
        output.twist.twist.linear.x = speed
        output.twist.twist.angular.z = yaw_rate
        return output

    def _publish_local(self, sample):
        output = self._make_odometry(
            sample.stamp,
            self._odom_frame,
            sample.x,
            sample.y,
            sample.yaw,
            sample.speed,
            sample.yaw_rate,
            self._local_position_variance,
        )
        self._local_publisher.publish(output)
        self._append_path(self._local_path, self._local_path_publisher, output)
        self._publish_vehicle_marker(sample)
        if self._publish_tf:
            self._broadcast_local(sample)

    def _publish_vehicle_marker(self, sample):
        marker = Marker()
        marker.header.stamp = sample.stamp
        marker.header.frame_id = self._odom_frame
        marker.ns = "vehicle_footprint"
        marker.id = 0
        marker.type = Marker.LINE_STRIP
        marker.action = Marker.ADD
        marker.pose.position.x = sample.x
        marker.pose.position.y = sample.y
        marker.pose.orientation = yaw_quaternion(sample.yaw)
        marker.scale.x = self._vehicle_outline_width
        marker.color.r = 0.15
        marker.color.g = 1.0
        marker.color.b = 0.35
        marker.color.a = 1.0
        for x, y in vehicle_outline_points(
            self._vehicle_length, self._vehicle_width
        ):
            marker.points.append(Point(x=x, y=y, z=0.05))
        self._vehicle_marker_publisher.publish(marker)

    def _publish_global_from_local(self, sample):
        x, y, yaw = compose_planar_pose(self._map_to_odom, sample)
        self._publish_global_pose(
            sample.stamp, x, y, yaw, sample.speed, sample.yaw_rate
        )
        if self._publish_tf:
            self._broadcast_map_to_odom(sample.stamp)

    def _publish_global_pose(self, stamp, x, y, yaw, speed, yaw_rate):
        output = self._make_odometry(
            stamp,
            self._map_frame,
            x,
            y,
            yaw,
            speed,
            yaw_rate,
            self._global_position_variance,
        )
        self._global_publisher.publish(output)
        self._append_path(self._global_path, self._global_path_publisher, output)

    def _append_path(self, path, publisher, odometry):
        pose = PoseStamped()
        pose.header = copy.deepcopy(odometry.header)
        pose.pose = copy.deepcopy(odometry.pose.pose)
        path.header = copy.deepcopy(odometry.header)
        path.poses.append(pose)
        if len(path.poses) > self._path_max_poses:
            del path.poses[: len(path.poses) - self._path_max_poses]
        publisher.publish(path)

    def _broadcast_local(self, sample):
        transform = TransformStamped()
        transform.header.stamp = sample.stamp
        transform.header.frame_id = self._odom_frame
        transform.child_frame_id = self._base_frame
        transform.transform.translation.x = sample.x
        transform.transform.translation.y = sample.y
        transform.transform.rotation = yaw_quaternion(sample.yaw)
        self._tf_broadcaster.sendTransform(transform)

    def _broadcast_map_to_odom(self, stamp):
        if self._map_to_odom is None:
            return
        transform = TransformStamped()
        transform.header.stamp = stamp
        transform.header.frame_id = self._map_frame
        transform.child_frame_id = self._odom_frame
        transform.transform.translation.x = self._map_to_odom[0]
        transform.transform.translation.y = self._map_to_odom[1]
        transform.transform.rotation = yaw_quaternion(self._map_to_odom[2])
        self._tf_broadcaster.sendTransform(transform)


if __name__ == "__main__":
    rospy.init_node("wheel_imu_gps_odometry")
    try:
        WheelImuGpsOdometryNode()
        rospy.spin()
    except (KeyError, TypeError, ValueError, rospy.ROSException) as error:
        rospy.logfatal("Wheel/IMU/GPS Odometry 설정 실패: %s", error)
        raise
