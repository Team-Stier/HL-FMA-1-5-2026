Panels:
  - Class: localization/LocalizationSensorStatusPanel
    Diagnostics Topic: /localization/live/diagnostics
    Name: Sensor Status
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Cell Size: 1
      Class: rviz/Grid
      Color: 105; 105; 110
      Enabled: true
      Name: Live Test ENU Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: odom_live_test
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.08
      Class: rviz/Pose
      Color: 255; 230; 70
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.12
      Name: Accepted GPS IMU Pose
      Shaft Length: 0.8
      Shaft Radius: 0.06
      Shape: Arrow
      Topic: /localization/live/current_pos
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: Real Encoder IMU Local Odometry (blue)
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Axes Length: 0.8
        Axes Radius: 0.06
        Color: 60; 160; 255
        Head Length: 0.25
        Head Radius: 0.10
        Shaft Length: 0.65
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /localization/live/local_odometry
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: Real GPS Corrected Global Odometry (pink)
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Axes Length: 0.9
        Axes Radius: 0.07
        Color: 255; 70; 200
        Head Length: 0.28
        Head Radius: 0.11
        Shaft Length: 0.75
        Shaft Radius: 0.055
        Value: Arrow
      Topic: /localization/live/global_odometry
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 60; 160; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Real Local Path
      Pose Style: None
      Topic: /localization/live/local_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 70; 200
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Real GPS Corrected Global Path
      Pose Style: None
      Topic: /localization/live/global_path
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /localization/live/vehicle_marker
      Name: Vehicle Footprint 1.35 x 0.85 m
      Namespaces:
        vehicle_footprint: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /localization/live/status_markers
      Name: REAL Sensor Status
      Namespaces:
        localization_sensor_health: true
      Queue Size: 10
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 33
    Fixed Frame: odom_live_test
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Angle: -1.57079637
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 30
      Target Frame: odom_live_test
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Width: 1450
  X: 60
  Y: 30
