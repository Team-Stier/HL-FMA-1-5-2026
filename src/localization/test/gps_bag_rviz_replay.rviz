Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Cell Size: 1
      Class: rviz/Grid
      Color: 100; 100; 105
      Enabled: true
      Name: First Fix ENU Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 30; 220; 100
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Recorded GPS Path
      Pose Style: None
      Topic: /localization/replay/gps_path
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /localization/replay/gps_markers
      Name: Current GPS Position
      Namespaces:
        gps_replay: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 33
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Angle: -1.57079637
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 15
      Target Frame: map
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1350
  X: 80
  Y: 40
