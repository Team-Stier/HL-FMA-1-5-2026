<launch>
  <!-- 센서 없는 RViz 확인 전용. 모든 입력/출력은 synthetic namespace다. -->
  <arg name="start_rviz" default="true"/>

  <include file="$(find localization)/launch/localization.launch">
    <arg name="config" value="$(find localization)/test/localization_test.yaml"/>
    <arg name="start_rviz" value="false"/>
    <arg name="localization_node_name" value="localization_synthetic_test"/>
    <arg name="odometry_node_name" value="wheel_imu_gps_odometry_synthetic_test"/>
    <arg name="status_node_name" value="localization_sensor_status_synthetic_test"/>
  </include>

  <node pkg="localization" type="synthetic_localization_debug.py"
        name="synthetic_localization_debug" output="screen"
        required="true"/>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="localization_debug_rviz"
        args="-d $(find localization)/test/localization_debug.rviz"
        output="screen" required="false"/>
</launch>
