Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Cell Size: 1
      Class: rviz/Grid
      Color: 105; 105; 110
      Enabled: true
      Name: Test ENU Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: odom
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: Synthetic Local Odometry (blue)
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Axes Length: 0.8
        Axes Radius: 0.06
        Color: 60; 160; 255
        Head Length: 0.25
        Head Radius: 0.10
        Shaft Length: 0.65
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /localization/synthetic/local_odometry
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: GPS Corrected Global Odometry (pink)
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Axes Length: 0.9
        Axes Radius: 0.07
        Color: 255; 70; 200
        Head Length: 0.28
        Head Radius: 0.11
        Shaft Length: 0.75
        Shaft Radius: 0.055
        Value: Arrow
      Topic: /localization/synthetic/global_odometry
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 60; 160; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Synthetic Local Path
      Pose Style: None
      Topic: /localization/synthetic/local_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 70; 200
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: GPS Corrected Global Path
      Pose Style: None
      Topic: /localization/synthetic/global_path
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /localization/synthetic/vehicle_marker
      Name: Vehicle Footprint 1.35 x 0.85 m
      Namespaces:
        vehicle_footprint: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /localization/synthetic/status_markers
      Name: SYNTHETIC TEST Sensor Status
      Namespaces:
        localization_sensor_health: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 33
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Angle: -1.57079637
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 30
      Target Frame: odom
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1360
  X: 80
  Y: 40
