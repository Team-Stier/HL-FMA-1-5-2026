<launch>
  <node pkg="localization" type="localization_node" name="localization_gate_test"
        output="screen" clear_params="true" required="true">
    <rosparam command="load" file="$(find localization)/test/localization_test.yaml"/>
    <!-- nonzero lever arm에서도 first_fix의 base pose가 정확히 (0,0)이어야 한다. -->
    <rosparam param="extrinsics/gps_translation_base_m">[1.2, -0.3, 0.4]</rosparam>
  </node>

  <test test-name="localization_pipeline" pkg="localization"
        type="test_localization_pipeline.py" time-limit="45"/>
</launch>
