<launch>
  <!-- 실제 센서를 읽는 test-only launch. 운영 /current_pos와 운영 TF 이름은 사용하지 않는다. -->
  <!-- bag의 /clock을 사용하지 않고 실제 센서 timestamp와 wall time만 사용한다. -->
  <param name="/use_sim_time" value="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="encoder_calibrated" default="true"/>
  <arg name="encoder_meters_per_tick" default="0.0188495555556"/>

  <include file="$(find localization)/launch/localization.launch">
    <arg name="config"
         value="$(find localization)/test/localization_live_test.yaml"/>
    <arg name="start_rviz" value="false"/>
    <arg name="localization_node_name" value="localization_live_test"/>
    <arg name="odometry_node_name" value="wheel_imu_gps_odometry_live_test"/>
    <arg name="status_node_name" value="localization_sensor_status_live_test"/>
    <arg name="override_encoder_calibration" value="true"/>
    <arg name="encoder_calibrated" value="$(arg encoder_calibrated)"/>
    <arg name="encoder_meters_per_tick" value="$(arg encoder_meters_per_tick)"/>
  </include>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="localization_live_sensor_rviz"
        args="-d $(find localization)/test/localization_live_sensor_debug.rviz"
        output="screen" required="false"/>
</launch>
