#!/usr/bin/env python3
"""Launch the standalone CSV capture process using a YAML configuration."""
import argparse
import os
from pathlib import Path
import sys

import yaml


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    # roslaunch appends __name and __log remappings to standalone processes.
    args = parser.parse_args([a for a in sys.argv[1:] if not a.startswith('__')])
    with open(args.config) as stream:
        config = yaml.safe_load(stream)
    if not isinstance(config, dict):
        parser.error('config must be a YAML mapping')
    port = config.get('port')
    if not isinstance(port, str) or not port.startswith('/dev/'):
        parser.error('port must be an explicit /dev/... path')
    baud = config.get('baud', 115200)
    if isinstance(baud, bool) or not isinstance(baud, int) or baud <= 0:
        parser.error('baud must be a positive integer')
    output = Path(config.get('output_root', '~/bags/can')).expanduser().resolve()
    command = [sys.executable, '-u', str(Path(__file__).resolve().with_name('capture_csv.py')),
               '--port', port, '--baud', str(baud), '--output-root', str(output),
               '--name', str(config.get('name', 'sensors'))]
    # Replace this process so roslaunch SIGINT reaches the capture loop directly.
    os.execv(sys.executable, command)


if __name__ == '__main__':
    main()
