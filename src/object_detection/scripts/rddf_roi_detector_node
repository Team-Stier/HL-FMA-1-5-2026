#!/usr/bin/env python3
"""Filter raw 2D LiDAR by optional RDDF/front ROI and run DBSCAN."""

import colorsys
import math
import threading

import numpy as np
import rospy
import tf2_ros
from geometry_msgs.msg import Point
from mando_localization.msg import RddfMatch
from sensor_msgs import point_cloud2
from sensor_msgs.msg import LaserScan, PointCloud2
from std_msgs.msg import ColorRGBA, Header
from tf.transformations import quaternion_matrix
from visualization_msgs.msg import Marker, MarkerArray

from object_detection_core import NOISE, dbscan, spatial_index_backend, voxel_downsample
from object_detection_core.rddf_roi import (
    RddfRouteNetwork,
    angular_roi_mask,
    circle_union_mask,
    lidar_forward_mask,
    vehicle_exclusion_mask,
)


def _positive(name, value, allow_zero=False):
    number = float(value)
    if not math.isfinite(number) or (number < 0 if allow_zero else number <= 0):
        raise ValueError(name + " must be " + ("nonnegative" if allow_zero else "positive"))
    return number


def laser_scan_points(scan):
    """Convert valid LaserScan rays to XYZ points in the scan frame."""
    if not scan.header.frame_id:
        raise ValueError("LaserScan frame is empty")
    metadata = (scan.angle_min, scan.angle_increment, scan.range_min, scan.range_max)
    if (not all(math.isfinite(value) for value in metadata)
            or scan.range_min < 0 or scan.range_max < scan.range_min
            or (len(scan.ranges) > 1 and scan.angle_increment == 0)):
        raise ValueError("invalid LaserScan metadata")
    indices = np.arange(len(scan.ranges), dtype=float)
    ranges = np.asarray(scan.ranges, dtype=float)
    valid = np.isfinite(ranges) & (ranges >= scan.range_min) & (ranges <= scan.range_max)
    angles = scan.angle_min + indices[valid] * scan.angle_increment
    xyz = np.column_stack((ranges[valid] * np.cos(angles),
                           ranges[valid] * np.sin(angles),
                           np.zeros(np.count_nonzero(valid), dtype=float)))
    return xyz


def transform_points(points, transform, source_frame):
    """Apply a target<-source TransformStamped to an XYZ array."""
    if (not source_frame or transform.child_frame_id.lstrip("/") != source_frame.lstrip("/")
            or not transform.header.frame_id):
        raise ValueError("point transform frames do not match")
    rotation_value = transform.transform.rotation
    quaternion = np.asarray((rotation_value.x, rotation_value.y,
                             rotation_value.z, rotation_value.w), dtype=float)
    translation_value = transform.transform.translation
    translation = np.asarray((translation_value.x, translation_value.y,
                              translation_value.z), dtype=float)
    if (not np.isfinite(quaternion).all() or not np.isfinite(translation).all()
            or np.linalg.norm(quaternion) < 1e-12):
        raise ValueError("invalid scan transform")
    rotation = quaternion_matrix(quaternion)[:3, :3]
    return points @ rotation.T + translation


def _color(cluster_id):
    hue = (cluster_id * 0.61803398875) % 1.0
    red, green, blue = colorsys.hsv_to_rgb(hue, 0.75, 1.0)
    return ColorRGBA(red, green, blue, 1.0)


def _clear_markers(header=None):
    clear = Marker()
    if header is not None:
        clear.header = header
    clear.action = Marker.DELETEALL
    return MarkerArray([clear])


def roi_markers(header, polylines, centers, radius, vehicle_box=None):
    output = _clear_markers(header)
    circles = Marker()
    circles.header = header
    circles.ns = "rddf_roi_circles"
    circles.id = 0
    circles.type = Marker.SPHERE_LIST
    circles.action = Marker.ADD
    circles.pose.orientation.w = 1.0
    circles.scale.x = circles.scale.y = radius * 2.0
    circles.scale.z = 0.03
    circles.color = ColorRGBA(0.1, 0.85, 1.0, 0.13)
    circles.points = [Point(float(x), float(y), 0.03) for x, y in centers]
    output.markers.append(circles)
    for index, polyline in enumerate(polylines):
        line = Marker()
        line.header = header
        line.ns = "rddf_roi_centerline"
        line.id = index
        line.type = Marker.LINE_STRIP
        line.action = Marker.ADD
        line.pose.orientation.w = 1.0
        line.scale.x = 0.12
        line.color = ColorRGBA(0.0, 1.0, 1.0, 0.95)
        line.points = [Point(float(x), float(y), 0.08) for x, y in polyline]
        output.markers.append(line)
    if vehicle_box is not None:
        base_frame, rear, front, right, left = vehicle_box
        box_header = Header(stamp=header.stamp, frame_id=base_frame)

        fill = Marker()
        fill.header = box_header
        fill.ns = "vehicle_self_filter_fill"
        fill.id = 0
        fill.type = Marker.CUBE
        fill.action = Marker.ADD
        fill.pose.position.x = (front - rear) * 0.5
        fill.pose.position.y = (left - right) * 0.5
        fill.pose.position.z = 0.025
        fill.pose.orientation.w = 1.0
        fill.scale.x = front + rear
        fill.scale.y = left + right
        fill.scale.z = 0.05
        fill.color = ColorRGBA(1.0, 0.08, 0.02, 0.13)
        output.markers.append(fill)

        outline = Marker()
        outline.header = box_header
        outline.ns = "vehicle_self_filter_outline"
        outline.id = 0
        outline.type = Marker.LINE_STRIP
        outline.action = Marker.ADD
        outline.pose.orientation.w = 1.0
        outline.scale.x = 0.08
        outline.color = ColorRGBA(1.0, 0.08, 0.02, 1.0)
        outline.points = [
            Point(-rear, -right, 0.10),
            Point(front, -right, 0.10),
            Point(front, left, 0.10),
            Point(-rear, left, 0.10),
            Point(-rear, -right, 0.10),
        ]
        output.markers.append(outline)
    return output


def cluster_markers(header, xyz, labels, point_size, centroid_size):
    # The stamped DELETEALL marker is also the validity heartbeat for a scan
    # that produced zero clusters. Consumers must distinguish that from the
    # headerless clear emitted when detector input is invalid.
    output = _clear_markers(header)
    for cluster_id in sorted(set(labels.tolist()) - {NOISE}):
        points = xyz[labels == cluster_id]
        color = _color(cluster_id)
        marker = Marker()
        marker.header = header
        marker.ns = "dbscan_clusters"
        marker.id = int(cluster_id)
        marker.type = Marker.POINTS
        marker.action = Marker.ADD
        marker.pose.orientation.w = 1.0
        marker.scale.x = marker.scale.y = point_size
        marker.color = color
        marker.points = [Point(float(point[0]), float(point[1]), float(point[2]))
                         for point in points]
        output.markers.append(marker)

        centroid = np.mean(points, axis=0)
        center = Marker()
        center.header = header
        center.ns = "dbscan_centroids"
        center.id = int(cluster_id)
        center.type = Marker.SPHERE
        center.action = Marker.ADD
        center.pose.position.x = float(centroid[0])
        center.pose.position.y = float(centroid[1])
        center.pose.position.z = float(centroid[2]) + centroid_size * 0.5
        center.pose.orientation.w = 1.0
        center.scale.x = center.scale.y = center.scale.z = centroid_size
        center.color = color
        output.markers.append(center)
    noise = Marker()
    noise.header = header
    noise.ns = "dbscan_noise"
    noise.id = 0
    noise.type = Marker.POINTS
    noise.action = Marker.ADD
    noise.pose.orientation.w = 1.0
    noise.scale.x = noise.scale.y = point_size * 0.65
    noise.color = ColorRGBA(0.45, 0.45, 0.45, 0.65)
    noise.points = [Point(float(point[0]), float(point[1]), float(point[2]))
                    for point, label in zip(xyz, labels) if label == NOISE]
    if noise.points:
        output.markers.append(noise)
    return output


class RddfRoiDetector:
    def __init__(self):
        self.map_frame = rospy.get_param("~frames/map", "map").lstrip("/")
        self.base_frame = rospy.get_param("~frames/base_link", "base_link").lstrip("/")
        self.lidar_frame = rospy.get_param("~frames/lidar", "laser_link").lstrip("/")
        self.corridor_enabled = rospy.get_param("~roi/corridor_enabled")
        if not isinstance(self.corridor_enabled, bool):
            raise ValueError("corridor_enabled must be Boolean")
        self.radius = _positive("corridor_radius_m", rospy.get_param("~roi/corridor_radius_m"))
        self.lookahead = _positive("lookahead_m", rospy.get_param("~roi/lookahead_m"))
        self.lookbehind = _positive(
            "lookbehind_m", rospy.get_param("~roi/lookbehind_m"), allow_zero=True)
        self.hold = _positive("match_hold_sec", rospy.get_param("~roi/match_hold_sec"))
        self.future_tolerance = _positive(
            "future_tolerance_sec", rospy.get_param("~roi/future_tolerance_sec"), allow_zero=True)
        self.max_depth = int(rospy.get_param("~roi/max_successor_depth"))
        connection_distance = _positive(
            "connection_distance_m", rospy.get_param("~roi/connection_distance_m"))
        self.network = (RddfRouteNetwork.from_directory(
            rospy.get_param("~rddf_directory"), connection_distance)
            if self.corridor_enabled else None)
        self.eps = _positive("eps", rospy.get_param("~eps"))
        self.min_samples = int(rospy.get_param("~min_samples"))
        self.voxel_size = _positive(
            "voxel_size_m", rospy.get_param("~voxel_size_m"), allow_zero=True)
        self.point_size = _positive("point_size", rospy.get_param("~point_size"))
        self.centroid_size = _positive(
            "centroid_size", rospy.get_param("~centroid_size"))
        self.lidar_forward_roi_enabled = rospy.get_param(
            "~roi/lidar_forward_roi/enabled")
        if not isinstance(self.lidar_forward_roi_enabled, bool):
            raise ValueError("lidar_forward_roi/enabled must be Boolean")
        self.lidar_min_forward = _positive(
            "lidar_forward_roi/min_forward_m",
            rospy.get_param("~roi/lidar_forward_roi/min_forward_m"), allow_zero=True)
        self.angular_roi_enabled = rospy.get_param("~roi/angular_roi/enabled")
        if not isinstance(self.angular_roi_enabled, bool):
            raise ValueError("angular_roi/enabled must be Boolean")
        self.angular_limits = (
            rospy.get_param("~roi/angular_roi/min_angle_deg"),
            rospy.get_param("~roi/angular_roi/max_angle_deg"),
        )
        angular_roi_mask(np.empty((0, 2)), *self.angular_limits)
        self.angular_limits = tuple(float(value) for value in self.angular_limits)
        self.self_filter_enabled = rospy.get_param("~roi/self_filter/enabled")
        if not isinstance(self.self_filter_enabled, bool):
            raise ValueError("self_filter/enabled must be Boolean")
        self.self_filter_visualize = rospy.get_param("~roi/self_filter/visualize")
        if not isinstance(self.self_filter_visualize, bool):
            raise ValueError("self_filter/visualize must be Boolean")
        self.vehicle_extents = (
            _positive("self_filter/rear_extent_m",
                      rospy.get_param("~roi/self_filter/rear_extent_m")),
            _positive("self_filter/front_extent_m",
                      rospy.get_param("~roi/self_filter/front_extent_m")),
            _positive("self_filter/right_extent_m",
                      rospy.get_param("~roi/self_filter/right_extent_m")),
            _positive("self_filter/left_extent_m",
                      rospy.get_param("~roi/self_filter/left_extent_m")),
        )
        dbscan([], self.eps, self.min_samples)
        if self.max_depth < 0:
            raise ValueError("max_successor_depth must be nonnegative")

        topics = rospy.get_param("~topics")
        self.roi_points_publisher = rospy.Publisher(
            topics["roi_points"], PointCloud2, queue_size=1)
        self.roi_marker_publisher = rospy.Publisher(
            topics["roi_markers"], MarkerArray, queue_size=1)
        self.cluster_publisher = rospy.Publisher(
            topics["clusters"], MarkerArray, queue_size=1)
        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer)
        self.lock = threading.Lock()
        self.match = None
        self.last_scan_stamp = None
        self.match_subscriber = (rospy.Subscriber(
            topics["current_rddf"], RddfMatch, self.match_callback, queue_size=1)
            if self.corridor_enabled else None)
        self.scan_subscriber = rospy.Subscriber(
            topics["scan"], LaserScan, self.scan_callback, queue_size=1)
        rospy.loginfo(
            "Object detector: scan=%s current_rddf=%s corridor=%s radius=%.2f lookahead=%.1f "
            "lidar_forward=%s[%.2f m] angle_roi=%s[%.1f, %.1f] self_filter=%s "
            "spatial=%s voxel=%.3f",
            topics["scan"], topics["current_rddf"], self.corridor_enabled,
            self.radius, self.lookahead,
            self.lidar_forward_roi_enabled, self.lidar_min_forward,
            self.angular_roi_enabled, self.angular_limits[0], self.angular_limits[1],
            self.self_filter_enabled, spatial_index_backend(), self.voxel_size)
        if spatial_index_backend() != "kd_tree":
            rospy.logwarn("python3-scipy가 없어 KD-tree 대신 NumPy/spatial-hash fallback을 사용합니다")

    def match_callback(self, message):
        if (not message.matched or not message.has_nearest or not message.source_route_name
                or message.source_route_name not in self.network.routes):
            return
        nearest = message.nearest
        if nearest.source_route_name and nearest.source_route_name != message.source_route_name:
            return
        stamp = message.pose_stamp.to_sec()
        if stamp <= 0 or not math.isfinite(stamp):
            return
        state = (message.source_route_name, int(message.segment_index),
                 float(nearest.segment_fraction), stamp)
        with self.lock:
            self.match = state

    def _clear_outputs(self, stamp):
        header = Header(stamp=stamp, frame_id=self.map_frame)
        self.roi_points_publisher.publish(point_cloud2.create_cloud_xyz32(header, []))
        self.roi_marker_publisher.publish(_clear_markers())
        self.cluster_publisher.publish(_clear_markers())

    def scan_callback(self, scan):
        stamp = scan.header.stamp.to_sec()
        if scan.header.frame_id.lstrip("/") != self.lidar_frame or stamp <= 0:
            rospy.logwarn_throttle(5.0, "RDDF ROI 생략: LiDAR frame 또는 timestamp 불일치")
            return
        with self.lock:
            if self.last_scan_stamp is not None and stamp < self.last_scan_stamp - 1.0:
                self.match = None
            self.last_scan_stamp = stamp
            match = self.match
        if self.corridor_enabled:
            if match is None:
                self._clear_outputs(scan.header.stamp)
                rospy.logwarn_throttle(5.0, "RDDF ROI 대기: 현재 RDDF match 없음")
                return
            source_route, segment_index, segment_fraction, match_stamp = match
            age = stamp - match_stamp
            if age < -self.future_tolerance or age > self.hold:
                self._clear_outputs(scan.header.stamp)
                rospy.logwarn_throttle(5.0, "RDDF ROI 대기: RDDF match가 오래되었거나 미래 시각임")
                return
        try:
            if self.corridor_enabled:
                polylines = self.network.corridor(
                    source_route, segment_index, segment_fraction,
                    self.lookahead, self.lookbehind, self.max_depth)
                centers = np.unique(np.round(np.vstack(polylines), 6), axis=0)
            else:
                polylines = []
                centers = np.empty((0, 2), dtype=float)
            map_transform = self.tf_buffer.lookup_transform(
                self.map_frame, scan.header.frame_id, scan.header.stamp, rospy.Duration(0.05))
            laser_xyz = laser_scan_points(scan)
            xyz = transform_points(laser_xyz, map_transform, scan.header.frame_id)
            keep = np.ones(len(xyz), dtype=bool)
            lidar_removed_count = 0
            removed_count = 0
            angle_removed_count = 0
            if (self.lidar_forward_roi_enabled or self.self_filter_enabled
                    or self.angular_roi_enabled):
                base_transform = self.tf_buffer.lookup_transform(
                    self.base_frame, scan.header.frame_id, scan.header.stamp,
                    rospy.Duration(0.05))
                base_xyz = transform_points(laser_xyz, base_transform, scan.header.frame_id)
                if self.lidar_forward_roi_enabled:
                    lidar_origin_x = base_transform.transform.translation.x
                    lidar_keep = lidar_forward_mask(
                        base_xyz[:, :2], lidar_origin_x, self.lidar_min_forward)
                    lidar_removed_count = int(np.count_nonzero(~lidar_keep))
                    keep &= lidar_keep
                if self.self_filter_enabled:
                    self_keep = vehicle_exclusion_mask(
                        base_xyz[:, :2], *self.vehicle_extents)
                    removed_count = int(np.count_nonzero(keep & ~self_keep))
                    keep &= self_keep
                if self.angular_roi_enabled:
                    angle_keep = angular_roi_mask(base_xyz[:, :2], *self.angular_limits)
                    angle_removed_count = int(np.count_nonzero(keep & ~angle_keep))
                    keep &= angle_keep
            xyz = xyz[keep]
            if self.corridor_enabled:
                mask = circle_union_mask(xyz[:, :2], centers, self.radius)
                filtered = xyz[mask]
            else:
                filtered = xyz
            clustered = (voxel_downsample(filtered, self.voxel_size)
                         if self.voxel_size > 0 else filtered)
            labels = dbscan(clustered[:, :2], self.eps, self.min_samples)
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException, ValueError, IndexError) as error:
            rospy.logwarn_throttle(5.0, "RDDF ROI 생략: %s", error)
            return
        header = Header(seq=scan.header.seq, stamp=scan.header.stamp, frame_id=self.map_frame)
        self.roi_points_publisher.publish(
            point_cloud2.create_cloud_xyz32(header, filtered.tolist()))
        self.roi_marker_publisher.publish(
            roi_markers(
                header, polylines, centers, self.radius,
                ((self.base_frame,) + self.vehicle_extents
                 if self.self_filter_enabled and self.self_filter_visualize else None)))
        self.cluster_publisher.publish(
            cluster_markers(
                header, clustered, labels, self.point_size, self.centroid_size))
        cluster_count = len(set(labels.tolist()) - {NOISE})
        rospy.logdebug(
            "Object ROI %s: roi=%d voxel=%d/%d points, lidar_x=%d self=%d angle=%d "
            "removed, %d clusters",
            source_route if self.corridor_enabled else "all-forward",
            len(filtered), len(clustered), len(xyz), lidar_removed_count,
            removed_count, angle_removed_count, cluster_count)


if __name__ == "__main__":
    rospy.init_node("rddf_roi_detector")
    RddfRoiDetector()
    rospy.spin()
