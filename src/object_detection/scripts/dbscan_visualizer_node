#!/usr/bin/env python3
"""Cluster a preprocessed 2D LiDAR cloud and publish RViz markers."""

import colorsys

import rospy
from geometry_msgs.msg import Point
from sensor_msgs import point_cloud2
from sensor_msgs.msg import PointCloud2
from std_msgs.msg import ColorRGBA
from visualization_msgs.msg import Marker, MarkerArray

from object_detection_core import NOISE, dbscan


def cluster_color(cluster_id):
    hue = (cluster_id * 0.61803398875) % 1.0
    red, green, blue = colorsys.hsv_to_rgb(hue, 0.75, 1.0)
    return ColorRGBA(red, green, blue, 1.0)


def markers_from_cloud(cloud, eps, min_samples, point_size):
    if cloud.header.frame_id != 'base_link':
        raise ValueError('input cloud frame must be base_link')
    xyz = list(point_cloud2.read_points(cloud, field_names=('x', 'y', 'z'), skip_nans=True))
    labels = dbscan([(point[0], point[1]) for point in xyz], eps, min_samples)
    output = MarkerArray()
    clear = Marker()
    clear.action = Marker.DELETEALL
    output.markers.append(clear)

    cluster_ids = sorted(set(labels) - {NOISE})
    for cluster_id in cluster_ids:
        marker = Marker()
        marker.header = cloud.header
        marker.ns = 'dbscan_clusters'
        marker.id = int(cluster_id)
        marker.type = Marker.POINTS
        marker.action = Marker.ADD
        marker.pose.orientation.w = 1.0
        marker.scale.x = marker.scale.y = point_size
        marker.color = cluster_color(cluster_id)
        marker.points = [Point(*point) for point, label in zip(xyz, labels) if label == cluster_id]
        output.markers.append(marker)

    noise = Marker()
    noise.header = cloud.header
    noise.ns = 'dbscan_noise'
    noise.id = 0
    noise.type = Marker.POINTS
    noise.action = Marker.ADD
    noise.pose.orientation.w = 1.0
    noise.scale.x = noise.scale.y = point_size * 0.65
    noise.color = ColorRGBA(0.45, 0.45, 0.45, 0.65)
    noise.points = [Point(*point) for point, label in zip(xyz, labels) if label == NOISE]
    if noise.points:
        output.markers.append(noise)
    return output, len(cluster_ids), len(xyz)


class DbscanVisualizer:
    def __init__(self):
        self.eps = rospy.get_param('~eps', 0.1)
        self.min_samples = rospy.get_param('~min_samples', 4)
        self.point_size = rospy.get_param('~point_size', 0.08)
        dbscan([], self.eps, self.min_samples)
        if not isinstance(self.point_size, (int, float)) or self.point_size <= 0:
            raise ValueError('point_size must be positive')
        self.publisher = rospy.Publisher('dbscan_clusters', MarkerArray, queue_size=1)
        self.subscriber = rospy.Subscriber('lidar_preprocessed', PointCloud2, self.callback, queue_size=1)
        rospy.loginfo('DBSCAN visualization: input=%s output=%s eps=%.3f min_samples=%d',
                      rospy.resolve_name('lidar_preprocessed'), rospy.resolve_name('dbscan_clusters'),
                      self.eps, self.min_samples)

    def callback(self, cloud):
        try:
            markers, cluster_count, point_count = markers_from_cloud(
                cloud, self.eps, self.min_samples, self.point_size)
        except (ValueError, KeyError) as error:
            rospy.logwarn_throttle(5.0, 'Skipping invalid preprocessed cloud: %s', error)
            return
        self.publisher.publish(markers)
        rospy.logdebug('DBSCAN clustered %d points into %d groups', point_count, cluster_count)


if __name__ == '__main__':
    rospy.init_node('dbscan_visualizer')
    DbscanVisualizer()
    rospy.spin()
