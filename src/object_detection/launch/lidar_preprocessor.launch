<launch>
  <arg name="input_topic" default="/scan"/>
  <arg name="output_topic" default="/lidar_preprocessed"/>
  <arg name="output_frame" default="lidar_preprocessed"/>
  <node pkg="object_detection" type="lidar_preprocessor_node" name="lidar_preprocessor" output="screen">
    <param name="output_frame" value="$(arg output_frame)"/>
    <remap from="scan" to="$(arg input_topic)"/>
    <remap from="lidar_preprocessed" to="$(arg output_topic)"/>
  </node>
</launch>
