<?xml version="1.0"?>
<package format="2">
  <name>path_planner</name>
  <version>0.1.0</version>
  <description>Frenet local path planner and ROS adapter for static-obstacle avoidance.</description>

  <maintainer email="team-stier@example.com">Team Stier</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>planning_interfaces</depend>
  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
</package>
